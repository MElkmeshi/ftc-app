APP_NAME="FTC App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_JOURNAL_MODE=wal
DB_BUSY_TIMEOUT=5000
DB_SYNCHRONOUS=normal

OCTANE_SERVER=frankenphp
TRUSTED_PROXIES=172.16.0.0/12
TELESCOPE_ENABLED=false

SESSION_DRIVER=file
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

BROADCAST_CONNECTION=reverb

# Shared secrets between the app and Reverb. docker/setup.sh fills them with
# random values; anyone who knows the secret can push fake scores and screen
# changes to every display on the network, so never use a known value.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Server-side ONLY: this is how the PHP backend (app/queue containers) reaches
# Reverb to publish events -- config/broadcasting.php's 'reverb' driver reads
# these three directly, nothing client-facing uses them. "reverb" is the
# docker-compose service name (resolved via Docker's internal DNS) and 8080 is
# Reverb's own container-internal port -- NOT the host-published 8081 from
# docker-compose.yml, which only works from outside the Docker network.
# Getting this wrong looks like: "Pusher error: cURL error 7: Failed to
# connect to localhost:8081" in storage/logs/laravel.log the moment any match
# action tries to broadcast.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Server-side: Reverb's own socket inside the container. Always plain HTTP --
# see docker-compose.yml / docker/php/Dockerfile for why (no TLS on a closed
# venue LAN; the app.tsx client derives wsHost from window.location at runtime
# so this works from any device's IP without rebuilding assets per venue).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_PORT=8081
# Deliberately empty (not omitted -- omitting would let a base .env's value
# leak through when Vite merges `--mode docker` env files). app.tsx falls back
# to window.location.hostname/protocol when these are empty, which is what
# lets a single `npm run build` work on whatever LAN IP a device actually used
# to reach the app, instead of needing a rebuild for every venue.
VITE_REVERB_HOST=
VITE_REVERB_SCHEME=
